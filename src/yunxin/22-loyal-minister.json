  "paragraphs": [
    "七律",
    "亘古忠臣",
    "二0二六年農曆四月初四日",
    "丹心烈烈耀商廷，直諫孤忠照汗青。",
    "一片精誠扶社稷，滿腔義氣振朝廷。",
    "敢披肝膽匡明主，寧舍身軀守德刑。",
    "千古高風垂萬古，千秋景仰比干靈。"
  ],
  "chars": 82,
  "source_file": "七律·亘古忠臣  (1).docx"
