  "paragraphs": [
    "詩一首",
    "重遊故地聖陶沙",
    "二0一八年 新加坡",
    "青天碧海美如畫，",
    "玉闕閬苑聖陶沙。",
    "獨特樂園遊客醉，",
    "全球名勝第一家。"
  ],
  "chars": 51,
