  "paragraphs": [
    "滿庭芳",
    "葛聯會廿六華誕",
    "二0二六年五月三十日",
    "葛水牽情，",
    "香江聚首，",
    "廿六載暖同舟。",
    "故園音貌，",
    "憶裏總悠悠。",
    "曾是分襟萬里，",
    "憑聯誼、",
    "再敘風流。",
    "逢佳節，",
    "杯傾醇釀，",
    "笑語滿層樓。",
    "休言山海隔，",
    "同心築夢，",
    "力展宏猷。",
    "念桑梓、",
    "常攜暖意相投。",
    "共護鄉音未改，",
    "承先志、",
    "譜寫新秋。",
    "從今後，",
    "情長如繭，",
    "歲歲續芳猷。",
    "，"
  ],
  "chars": 138,
