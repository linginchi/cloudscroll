  "paragraphs": [
    "詩二首",
    "小滿",
    "二0二一年",
    "小滿時來節氣長，",
    "芸苔山杏紛登場。",
    "金黃麥子豐收悅，",
    "肥胖桑蠶做絲長。",
    "悼念隆平公",
    "二0二一年",
    "甘於奉獻隆平老，",
    "汗水澆淋稻花香。",
    "喜看稻田千重浪，",
    "雜交水稻萬斤糧。",
    "神州百姓無饑餓，",
    "袁老神農贊譽揚。",
    "華夏神農袁老逝，",
    "隆平公舉世無雙。"
  ],
  "chars": 116,
