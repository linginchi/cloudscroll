  "paragraphs": [
    "七 律",
    "咏海上花園廈門",
    "二0一八年五月",
    "鷺洲海上花園譽，",
    "美景如詩鷺江島。",
    "胡里炮台抗外侮，",
    "浮橋海上水映橋。",
    "日光岩上憑欄眺，",
    "鼓浪琴聲裊裊飄。",
    "海水有情城有義，",
    "海城互映錦秀姣。"
  ],
  "chars": 81,
  "source_file": "《七律·詠海上花園廈門》(1).docx"
}